CREATE TABLE CanvasNodeEntity(
id TEXT NOT NULL PRIMARY KEY,
noteId TEXT NOT NULL REFERENCES Notes(id) ON DELETE CASCADE,
kind TEXT NOT NULL,
name TEXT NOT NULL DEFAULT '',
contentId TEXT REFERENCES NoteContent(id) ON DELETE CASCADE,
parentId TEXT REFERENCES CanvasNodeEntity(id) ON DELETE SET NULL,
x REAL NOT NULL DEFAULT 0.0,
y REAL NOT NULL DEFAULT 0.0,
width REAL NOT NULL DEFAULT 0.0,
height REAL NOT NULL DEFAULT 0.0,
z INTEGER NOT NULL DEFAULT 0,
locked INTEGER NOT NULL DEFAULT 0,
hidden INTEGER NOT NULL DEFAULT 0,
links TEXT NOT NULL DEFAULT '',
updatedAt TEXT
);

CREATE INDEX idx_canvasnode_note ON CanvasNodeEntity(noteId, z);

CREATE INDEX idx_canvasnode_viewport ON CanvasNodeEntity(noteId, x, y);

CREATE TABLE CanvasViewport(
noteId TEXT NOT NULL PRIMARY KEY REFERENCES Notes(id) ON DELETE CASCADE,
offsetX REAL NOT NULL DEFAULT 0.0,
offsetY REAL NOT NULL DEFAULT 0.0,
scale REAL NOT NULL DEFAULT 1.0,
updatedAt TEXT
);
