CREATE TABLE CanvasNode(
id TEXT NOT NULL PRIMARY KEY,
noteId TEXT NOT NULL,
kind TEXT NOT NULL,
contentId TEXT,
parentId TEXT,
x REAL NOT NULL DEFAULT 0.0,
y REAL NOT NULL DEFAULT 0.0,
width REAL NOT NULL DEFAULT 0.0,
height REAL NOT NULL DEFAULT 0.0,
z INTEGER NOT NULL DEFAULT 0,
locked INTEGER NOT NULL DEFAULT 0,
hidden INTEGER NOT NULL DEFAULT 0,
links TEXT NOT NULL DEFAULT '',
updatedAt TEXT
);

CREATE INDEX idx_canvasnode_note ON CanvasNode(noteId, z);

CREATE INDEX idx_canvasnode_viewport ON CanvasNode(noteId, x, y);

CREATE TABLE CanvasViewport(
noteId TEXT NOT NULL PRIMARY KEY,
offsetX REAL NOT NULL DEFAULT 0.0,
offsetY REAL NOT NULL DEFAULT 0.0,
scale REAL NOT NULL DEFAULT 1.0,
updatedAt TEXT
);
