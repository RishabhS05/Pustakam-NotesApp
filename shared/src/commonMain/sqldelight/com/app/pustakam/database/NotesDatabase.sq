import com.app.pustakam.data.localdb.database.RichTextMetadata;

-- 🔧 21-Jul-2026 databasev2.md §2.4: offline-first sync fields — ownerId/version are app-generated
--   uuid strings (never hardcoded), syncStatus drives the sync queue, deleted = soft delete tombstone.
--   Existing installs get these via migration 3.sqm (v3 -> v4).
CREATE TABLE Notes (
 id TEXT NOT NULL PRIMARY KEY,
 categoryId TEXT,
 title TEXT,
 createdAt TEXT,
 updatedAt TEXT,
 ownerId TEXT,
 version TEXT NOT NULL DEFAULT '',
 syncStatus TEXT NOT NULL DEFAULT 'PENDING',
 deleted INTEGER NOT NULL DEFAULT 0
);

-- 🔧 C4: position INTEGER → REAL (fractional ordering)
-- 🔧 C1/S1: + title (was never persisted!), mimeType, sizeBytes, width, height, thumbnailPath
CREATE TABLE NoteContent(
id TEXT NOT NULL PRIMARY KEY,
noteId TEXT NOT NULL REFERENCES Notes(id) ON DELETE CASCADE ,
type TEXT NOT NULL,
position REAL,
createdAt TEXT,
updatedAt TEXT,
localPath TEXT,
url TEXT,
text TEXT,
lat  REAL,
long REAL,
address TEXT,
duration INTEGER,
title TEXT,
mimeType TEXT,
sizeBytes INTEGER,
width INTEGER,
height INTEGER,
thumbnailPath TEXT,
metaData TEXT AS RichTextMetadata
);

-- 🔧 15-Jul-2026 Phase 0.2: composite index — every content fetch filters by noteId and sorts by
--   position; without this the JOIN/WHERE scans the whole NoteContent table. Existing installs get
--   it via migration 1.sqm (v1 -> v2).
CREATE INDEX idx_notecontent_note_position ON NoteContent(noteId, position);

-- 🔧 15-Jul-2026 CRASH FIX ("no such module: fts5"): the FTS5 virtual table + triggers were
--   REMOVED from this schema. Some devices' framework SQLite is built WITHOUT the fts5 module
--   (crashed at Schema.create on a real device), so the managed schema must only contain SQL
--   every device supports. FTS5 is now created AT RUNTIME, only where supported and only when
--   search is first used — see NotesDao.ensureFtsIndex(); other devices use searchContentTextLike.

CREATE TABLE Tags(
id TEXT NOT NULL PRIMARY KEY,
color TEXT,
label TEXT);
-- 🔧 21-Jul-2026 databasev2.md §2.4: now persists sync fields (ownerId/version/syncStatus/deleted)
insertOrUpdateNote:
INSERT OR REPLACE INTO Notes(id, categoryId, title, createdAt, updatedAt, ownerId, version, syncStatus, deleted)
VALUES(?,?,?,?,?,?,?,?,?);

-- 🔧 C1/S1: now persists title + media metadata
insertNoteContentById:
INSERT OR REPLACE INTO NoteContent ( id ,noteId, type, position, createdAt, updatedAt, localPath, url , text,  lat , long, address, duration, title, mimeType, sizeBytes, width, height, thumbnailPath, metaData )
VALUES (? , ?, ?, ?,  ?, ?, ?, ?, ?,? , ?, ?, ?, ?, ?, ?, ?, ?, ? ,?);

-- 🔧 21-Jul-2026 databasev2.md §2.4: an edit re-marks the row dirty (syncStatus) and stamps version
updateNotesById:
UPDATE Notes
SET title = ?, updatedAt = ?, version = ?, syncStatus = ?
WHERE id = ?;

updateNoteContentById:
UPDATE NoteContent
SET type = ?, position = ?, text = ?, url = ?, lat = ?, long = ?, metaData = ?
WHERE id = ?;

deleteNoteContentById:
DELETE FROM NoteContent
WHERE id = ?;

selectAllNotesContent:
SELECT * FROM NoteContent
WHERE noteId = ?
ORDER BY position ASC;


SELECT * FROM NoteContent
WHERE id = ?;

selectAll:
SELECT * FROM Notes;

selectById:
SELECT
    Notes.id AS noteId,
    Notes.categoryId,
    Notes.title,
    Notes.createdAt AS noteCreatedAt,
    Notes.updatedAt AS noteUpdatedAt,
    Notes.ownerId, -- 🔧 21-Jul-2026 databasev2.md §2.4: sync fields flow to the Note model
    Notes.version,
    Notes.syncStatus,
    Notes.deleted,
    NoteContent.id AS contentId,
    NoteContent.type,
    NoteContent.position,
    NoteContent.createdAt AS contentCreatedAt,
    NoteContent.updatedAt AS contentUpdatedAt,
    NoteContent.localPath,
    NoteContent.url,
    NoteContent.text,
    NoteContent.lat,
    NoteContent.long,
    NoteContent.address,
    NoteContent.duration,
    NoteContent.title AS contentTitle, -- 🔧 S1: media's OWN title (row.title was the note's title!)
    NoteContent.mimeType,
    NoteContent.sizeBytes,
    NoteContent.width,
    NoteContent.height,
    NoteContent.thumbnailPath,
    NoteContent.metaData
FROM Notes
LEFT JOIN NoteContent ON Notes.id = NoteContent.noteId
WHERE Notes.id = ?
ORDER BY NoteContent.position;

deleteById :
DELETE FROM Notes WHERE  id = ? ;

-- 🔧 15-Jul-2026 Phase 0.1: one PAGE of note ids for the list screen. Paging happens on Notes ids
--   (LIMIT on the joined query would cut a note in the middle of its contents). The DAO then loads
--   each id with the existing selectById mapper. Ordered by id = creation order (ids are
--   timestamp-prefixed, see UniqueIdGenerator).
selectNoteIdsPage:
SELECT id FROM Notes
ORDER BY id
LIMIT :limit OFFSET :offset;

-- 🔧 15-Jul-2026 Summary query: everything the LIST SCREEN needs, WITHOUT loading contents.
--   snippet: first non-empty TEXT block (may be NULL — media/doc-only notes are normal!);
--   per-type counts let the card describe textless notes ("3 photos · 1 audio");
--   thumbnail: first visual media's thumbnailPath (falls back to the file itself).
--   Every subquery hits idx_notecontent_note_position.
selectNoteSummariesPage:
SELECT
    n.id,
    n.categoryId,
    n.title,
    n.createdAt,
    n.updatedAt,
    (SELECT SUBSTR(c.text, 1, 200) FROM NoteContent c
        WHERE c.noteId = n.id AND c.type = 'TEXT' AND c.text IS NOT NULL AND c.text != ''
        ORDER BY c.position LIMIT 1) AS snippet,
    (SELECT COUNT(*) FROM NoteContent c WHERE c.noteId = n.id) AS contentCount,
    (SELECT COUNT(*) FROM NoteContent c WHERE c.noteId = n.id AND c.type IN ('IMAGE','GIF')) AS imageCount,
    (SELECT COUNT(*) FROM NoteContent c WHERE c.noteId = n.id AND c.type = 'VIDEO') AS videoCount,
    (SELECT COUNT(*) FROM NoteContent c WHERE c.noteId = n.id AND c.type = 'AUDIO') AS audioCount,
    (SELECT COUNT(*) FROM NoteContent c WHERE c.noteId = n.id AND c.type IN ('PDF','DOCX')) AS docCount,
    (SELECT COALESCE(c.thumbnailPath, c.localPath, c.url) FROM NoteContent c
        WHERE c.noteId = n.id AND c.type IN ('IMAGE','VIDEO','GIF')
        ORDER BY c.position LIMIT 1) AS thumbnailPath
FROM Notes n
ORDER BY n.id
LIMIT :limit OFFSET :offset;

selectWithAllContent:
SELECT
    Notes.id AS noteId,
    Notes.categoryId,
    Notes.title,
    Notes.createdAt AS noteCreatedAt,
    Notes.updatedAt AS noteUpdatedAt,
    Notes.ownerId, -- 🔧 21-Jul-2026 databasev2.md §2.4: sync fields flow to the Note model
    Notes.version,
    Notes.syncStatus,
    Notes.deleted,
    NoteContent.id AS contentId,
    NoteContent.type,
    NoteContent.position,
    NoteContent.createdAt AS contentCreatedAt,
    NoteContent.updatedAt AS contentUpdatedAt,
    NoteContent.localPath,
    NoteContent.url,
    NoteContent.text,
    NoteContent.lat,
    NoteContent.long,
    NoteContent.address,
    NoteContent.duration,
    NoteContent.title AS contentTitle, -- 🔧 S1: media's OWN title
    NoteContent.mimeType,
    NoteContent.sizeBytes,
    NoteContent.width,
    NoteContent.height,
    NoteContent.thumbnailPath,
    NoteContent.metaData
FROM Notes
LEFT JOIN NoteContent ON Notes.id = NoteContent.noteId
ORDER BY Notes.id, NoteContent.position;
-- LIMIT ? OFFSET ?;

-- 🔧 15-Jul-2026 CRASH FIX: content search that works on EVERY SQLite build (no fts5 module
--   required). Used as the fallback when the device lacks FTS5; capable devices get the faster
--   MATCH variant at runtime (NotesDao.searchContentViaFts). Same result shape.
searchContentTextLike:
SELECT
    n.id, n.categoryId, n.title, n.createdAt, n.updatedAt,
    SUBSTR(c.text, 1, 200) AS snippet
FROM NoteContent c
JOIN Notes n ON n.id = c.noteId
WHERE c.type = 'TEXT' AND c.text LIKE '%' || :query || '%'
GROUP BY n.id
ORDER BY n.updatedAt DESC
LIMIT 50;

-- 🔧 15-Jul-2026 Phase 2.2: title search (titles are not in the FTS index) — merged with the
--   content matches in the DAO.
searchTitles:
SELECT id, categoryId, title, createdAt, updatedAt
FROM Notes
WHERE title LIKE '%' || :query || '%'
ORDER BY updatedAt DESC
LIMIT 50;

createTag:
INSERT OR REPLACE INTO Tags(id, label, color)
VALUES(?,?,?);

updateTag:
UPDATE Tags
SET color = ?, label = ?
WHERE id = ?;

deleteTag :
DELETE FROM Tags WHERE id = ?;

getTags:
SELECT id, label, color FROM Tags;

getTag:
SELECT id, label, color FROM Tags WHERE id = ?;