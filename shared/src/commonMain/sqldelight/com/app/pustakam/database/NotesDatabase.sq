import com.app.pustakam.data.localdb.database.RichTextMetadata;

CREATE TABLE Notes (
 id TEXT NOT NULL PRIMARY KEY,
 categoryId TEXT,
 title TEXT,
 createdAt TEXT,
 updatedAt TEXT
);

-- 🔧 C4: position INTEGER → REAL (fractional ordering)
-- 🔧 C1/S1: + title (was never persisted!), mimeType, sizeBytes, width, height, thumbnailPath
CREATE TABLE NoteContent(
id TEXT NOT NULL PRIMARY KEY,
noteId TEXT NOT NULL REFERENCES Notes(id) ON DELETE CASCADE ,
type TEXT NOT NULL,
position REAL,
createdAt TEXT,
updatedAt TEXT,
localPath TEXT,
url TEXT,
text TEXT,
lat  REAL,
long REAL,
address TEXT,
duration INTEGER,
title TEXT,
mimeType TEXT,
sizeBytes INTEGER,
width INTEGER,
height INTEGER,
thumbnailPath TEXT,
metaData TEXT AS RichTextMetadata
);

-- 🔧 15-Jul-2026 Phase 0.2: composite index — every content fetch filters by noteId and sorts by
--   position; without this the JOIN/WHERE scans the whole NoteContent table. Existing installs get
--   it via migration 1.sqm (v1 -> v2).
CREATE INDEX idx_notecontent_note_position ON NoteContent(noteId, position);

CREATE TABLE Tags(
id TEXT NOT NULL PRIMARY KEY,
color TEXT,
label TEXT);
insertOrUpdateNote:
INSERT OR REPLACE INTO Notes(id, categoryId, title, createdAt,updatedAt)
VALUES(?,?,?,?,?);

-- 🔧 C1/S1: now persists title + media metadata
insertNoteContentById:
INSERT OR REPLACE INTO NoteContent ( id ,noteId, type, position, createdAt, updatedAt, localPath, url , text,  lat , long, address, duration, title, mimeType, sizeBytes, width, height, thumbnailPath, metaData )
VALUES (? , ?, ?, ?,  ?, ?, ?, ?, ?,? , ?, ?, ?, ?, ?, ?, ?, ?, ? ,?);

updateNotesById:
UPDATE Notes
SET title = ?, updatedAt = ?
WHERE id = ?;

updateNoteContentById:
UPDATE NoteContent
SET type = ?, position = ?, text = ?, url = ?, lat = ?, long = ?, metaData = ?
WHERE id = ?;

deleteNoteContentById:
DELETE FROM NoteContent
WHERE id = ?;

selectAllNotesContent:
SELECT * FROM NoteContent
WHERE noteId = ?
ORDER BY position ASC;


SELECT * FROM NoteContent
WHERE id = ?;

selectAll:
SELECT * FROM Notes;

selectById:
SELECT
    Notes.id AS noteId,
    Notes.categoryId,
    Notes.title,
    Notes.createdAt AS noteCreatedAt,
    Notes.updatedAt AS noteUpdatedAt,
    NoteContent.id AS contentId,
    NoteContent.type,
    NoteContent.position,
    NoteContent.createdAt AS contentCreatedAt,
    NoteContent.updatedAt AS contentUpdatedAt,
    NoteContent.localPath,
    NoteContent.url,
    NoteContent.text,
    NoteContent.lat,
    NoteContent.long,
    NoteContent.address,
    NoteContent.duration,
    NoteContent.title AS contentTitle, -- 🔧 S1: media's OWN title (row.title was the note's title!)
    NoteContent.mimeType,
    NoteContent.sizeBytes,
    NoteContent.width,
    NoteContent.height,
    NoteContent.thumbnailPath,
    NoteContent.metaData
FROM Notes
LEFT JOIN NoteContent ON Notes.id = NoteContent.noteId
WHERE Notes.id = ?
ORDER BY NoteContent.position;

deleteById :
DELETE FROM Notes WHERE  id = ? ;

-- 🔧 15-Jul-2026 Phase 0.1: one PAGE of note ids for the list screen. Paging happens on Notes ids
--   (LIMIT on the joined query would cut a note in the middle of its contents). The DAO then loads
--   each id with the existing selectById mapper. Ordered by id = creation order (ids are
--   timestamp-prefixed, see UniqueIdGenerator).
selectNoteIdsPage:
SELECT id FROM Notes
ORDER BY id
LIMIT :limit OFFSET :offset;

selectWithAllContent:
SELECT
    Notes.id AS noteId,
    Notes.categoryId,
    Notes.title,
    Notes.createdAt AS noteCreatedAt,
    Notes.updatedAt AS noteUpdatedAt,
    NoteContent.id AS contentId,
    NoteContent.type,
    NoteContent.position,
    NoteContent.createdAt AS contentCreatedAt,
    NoteContent.updatedAt AS contentUpdatedAt,
    NoteContent.localPath,
    NoteContent.url,
    NoteContent.text,
    NoteContent.lat,
    NoteContent.long,
    NoteContent.address,
    NoteContent.duration,
    NoteContent.title AS contentTitle, -- 🔧 S1: media's OWN title
    NoteContent.mimeType,
    NoteContent.sizeBytes,
    NoteContent.width,
    NoteContent.height,
    NoteContent.thumbnailPath,
    NoteContent.metaData
FROM Notes
LEFT JOIN NoteContent ON Notes.id = NoteContent.noteId
ORDER BY Notes.id, NoteContent.position;
-- LIMIT ? OFFSET ?;

createTag:
INSERT OR REPLACE INTO Tags(id, label, color)
VALUES(?,?,?);

updateTag:
UPDATE Tags
SET color = ?, label = ?
WHERE id = ?;

deleteTag :
DELETE FROM Tags WHERE id = ?;

getTags:
SELECT id, label, color FROM Tags;

getTag:
SELECT id, label, color FROM Tags WHERE id = ?;