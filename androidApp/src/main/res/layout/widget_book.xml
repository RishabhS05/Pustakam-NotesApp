<?xml version="1.0" encoding="utf-8"?>
<!-- 🔧 18-Jul-2026: Book widget layout — a small leather book cover; tap opens the reader -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_book_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_book_bg"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="14dp">

    <View
        android:layout_width="34dp"
        android:layout_height="3dp"
        android:background="@drawable/widget_book_spine" />

    <TextView
        android:id="@+id/widget_book_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/book_widget_default_title"
        android:textColor="#FAF3E3"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_book_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/book_widget_open_hint"
        android:textColor="#D9B36C"
        android:textSize="11sp" />

    <View
        android:layout_width="34dp"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_book_spine" />
</LinearLayout>
